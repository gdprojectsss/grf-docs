{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grf-sh",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/install", "/install.sh", "/latest", "/download/*"]
  },
  "routes": [
    { "pattern": "grf.sh", "custom_domain": true },
    { "pattern": "www.grf.sh", "custom_domain": true }
  ]
}
